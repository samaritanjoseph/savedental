# Save Dental — Backend Environment Variables
# Copy this file to .env and fill in your values

# JWT secret key (use a long random string in production)
JWT_SECRET=SaveDental_Secure_JWT_Key_2024_do_not_share

# SMTP Email Configuration (Brevo / SendGrid / any SMTP provider)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your-smtp-user@smtp-brevo.com
SMTP_PASS=your-smtp-password
SMTP_SECURE=false

# Admin notification email (where booking alerts go)
ADMIN_EMAIL=admin@yourdomain.com

# Server port (default: 3001)
PORT=3001
